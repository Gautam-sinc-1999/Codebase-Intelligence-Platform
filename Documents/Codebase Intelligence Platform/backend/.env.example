# Copy to backend/.env and fill in. That file is git-ignored, and the indexer treats any .env as a
# secret — it is never read into an index or extracted to disk.
#
#   cp backend/.env.example backend/.env

# ── LLM ────────────────────────────────────────────────────────────────────────
# Without a key the system still answers: every response is assembled from the retrieved
# chunks by a rule-based template, cites real files and line ranges, and is flagged
# degraded: true. Retrieval, the call graph and citations are unaffected.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# DEFAULT_LLM_MODEL=gpt-4o

# ── Datastores ─────────────────────────────────────────────────────────────────
# Each of these falls back to an in-process equivalent when unreachable. GET / reports
# which backend each one actually resolved to.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=Codebase_Intelligence
REDIS_URI=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Storage ────────────────────────────────────────────────────────────────────
DATA_DIR=./data
CHROMADB_DIR=./data/chroma_db

# ── Limits ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=262144000
MAX_ARCHIVE_ENTRIES=20000
MAX_INDEXED_FILE_BYTES=2097152
# Total prompt budget in tokens. Groq's free tier allows 8,000 per minute and the
# completion counts against it, so the request must leave room to be answered.
MAX_PROMPT_TOKENS=5000

# ── Observability (optional) ───────────────────────────────────────────────────
# Leave blank to disable tracing entirely. With both keys set, every query is traced and
# scored. Start the stack with: docker compose --profile observability up -d
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3001

# ── Evaluation judge (optional) ────────────────────────────────────────────────
# Used only by scripts/run_ragas.py, never in the request path. Deliberately a SEPARATE
# provider from the one that answers questions: RAGAS metrics cost 15-30 LLM calls per item,
# so sharing GROQ_API_KEY would make an evaluation run compete with live answers for the same
# rate limit. Defaults to Gemini, which is free without a card and needs no extra client code
# because it speaks the OpenAI schema. Get a key at https://aistudio.google.com/apikey
# JUDGE_API_KEY=
# JUDGE_PROVIDER=gemini
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# JUDGE_MODEL=gemini-2.0-flash
# JUDGE_MAX_CONCURRENCY=2          # free tiers cap requests per minute, so the harness paces itself

# ── Security ───────────────────────────────────────────────────────────────────
# Set API_KEY to require X-API-Key on every route; set VITE_API_KEY in the frontend to match.
# API_KEY=
# CORS_ORIGINS=http://localhost:3000
